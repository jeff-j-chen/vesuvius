#*.pth
# keep MAE pretraining bases (warm-start weights) tracked despite the blanket *.pth ignore
#!models/mae_*.pth
*.npz
.venv
__pycache__/
*.pyc
*.tar
ves_3zars.tar
ves_zarrs*
# cross-resolution tile stores are rebuilt by crossres/build_pairs.py; their meta.json files stay tracked
crossres/pairs/**/pairs.zarr/
.vscode/*
_ves_tmp/
PHerc0813_spiral_dataset/*
# atlas extras are synced through R2 (assemble_test_segments.py --include-extras), never git
tifxyz/atlas/
masks/extras/
surface_labels/
output/
crossres/
# run outputs stay local to keep LFS under quota; already-tracked files are unaffected
nader-fork/
reader-v2/
reader-v3/
villa-ink/
hecate/
runs_smoke/
models/runs_smoke/
# cue maps are LFS-sized and rebuilt by assemble_*_segments.py --mix6 (build_domain_cues.py / build_pair_cues.py)
cue_*/
# per-run evaluation figures
eval_figs/
# local run outputs, too large for GitHub
runs_corr/
models/ckpt_002000.pth